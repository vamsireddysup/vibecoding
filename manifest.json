{
  "manifest_version": 3,
  "name": "Meeting Notes (BYOK)",
  "version": "0.2.0",
  "description": "Transcribe meetings locally in your browser, then summarize them with your own Claude or ChatGPT API key.",
  "minimum_chrome_version": "139",

  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "activeTab",
    "audioCapture"
  ],

  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],

  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["src/content/participants.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "background": {
    "service_worker": "src/sw.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "src/ui/panel.html"
  },

  "options_page": "src/ui/settings.html",

  "action": {
    "default_title": "Meeting Notes"
  },

  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Start or stop recording the current meeting"
    }
  },

  "icons": {
    "128": "icons/icon128.png"
  }
}
