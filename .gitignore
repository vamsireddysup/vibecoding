# Local settings / keys must never be committed.
# The extension stores the user's API key in chrome.storage.local, not on disk,
# but keep this here in case anyone adds a local config file.
*.local.json
.env

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*.swp

# Packaging output
*.zip
*.crx
*.pem
node_modules/
